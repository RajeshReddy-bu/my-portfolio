run = "cd server && node index.js"
entrypoint = "server/index.js"
onBoot = "bash build.sh"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "cd server && node index.js"]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "bash build.sh"]

[[ports]]
localPort = 5000
externalPort = 80

